# Supabase CLI local link state (project ref, pooler URL, service versions).
# Machine-local and regenerated by `supabase link`; it is not repo state, and
# leaving it untracked-but-visible is one careless `git add -A` from committing
# a developer's connection details. Law 7 stages explicit paths for the same
# reason — this closes the other half.
supabase/.temp/

# Playwright QA harness — screenshots + browser/report artifacts (never committed)
_qa/
/test-results/
/playwright-report/
/blob-report/
/.playwright/
